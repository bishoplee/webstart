# ==============================================================================
# WEBSTART — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` or `.env.local` for local development.
# Never commit real `.env` or `.env.local` files to version control.
# Never expose server-only secrets via NEXT_PUBLIC_ variables.

# ------------------------------------------------------------------------------
# 1. APPLICATION URL (REQUIRED)
# ------------------------------------------------------------------------------
# Development: http://localhost:3000
# Production:  https://your-webstart-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE — NEON POSTGRESQL (REQUIRED)
# ------------------------------------------------------------------------------
# Pooled connection string for serverless execution (used at runtime)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/webstart?sslmode=require

# Direct connection string for Drizzle schema migrations (optional fallback to DATABASE_URL)
DIRECT_DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/webstart?sslmode=require

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION — CLERK (REQUIRED)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_optional_replace_me

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ------------------------------------------------------------------------------
# 4. FILE STORAGE — CLOUDINARY (OPTIONAL IN DEV / REQUIRED IN PROD)
# ------------------------------------------------------------------------------
# All uploads & signed download URLs are generated server-side.
# Never expose CLOUDINARY_API_SECRET to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATIONS — RESEND (OPTIONAL)
# ------------------------------------------------------------------------------
# When unconfigured, WebStart gracefully degrades: notifications are marked as
# unconfigured, admins see a notice, and invitation links remain copyable.
RESEND_API_KEY=
EMAIL_FROM="WebStart Discovery <onboarding@yourdomain.com>"

# ------------------------------------------------------------------------------
# 6. BOT PROTECTION — CLOUDFLARE TURNSTILE (OPTIONAL)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
